# --- Sensitive: camera feed URLs / credentials ---
# Real config lives in ~/.config/hometv/cameras.json (outside this repo).
# These rules guard against any copy ever landing inside the project tree.
cameras.json
**/cameras.json
.config/
*.sdp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.Python

# --- Virtual environments ---
venv/
.venv/
env/

# --- PyInstaller build artifacts ---
build/
dist/
*.manifest

# --- macOS ---
.DS_Store

# --- Editor / IDE ---
.idea/
.vscode/

# --- Claude Code local settings (personal, not for the repo) ---
.claude/settings.local.json
